    // Включение тактирования (RCC) и разбивка используемых GPIO портов
{%- for port in used_ports %}
    let mut gpio{{ port }} = dp.GPIO{{ port | upper }}.split(&mut rcc.apb2);
{%- endfor %}

    // Настройка пользовательских GPIO пинов
{%- for pin in gpio_pins %}
    let mut {{ pin.label }} = gpio{{ pin.port }}.p{{ pin.port }}{{ pin.pin_num }}.{{ pin.method }}(&mut gpio{{ pin.port }}.{{ pin.cr_reg }});
{%- endfor %}

    // Настройка шин SPI
{%- for spi in spis %}
    // Пины для шины {{ spi.bus_name | upper }}
    let sck_{{ spi.bus_name }} = gpio{{ spi.sck.port }}.p{{ spi.sck.port }}{{ spi.sck.pin_num }}.into_alternate_push_pull(&mut gpio{{ spi.sck.port }}.{{ spi.sck.cr_reg }});
{%- if spi.miso %}
    let miso_{{ spi.bus_name }} = gpio{{ spi.miso.port }}.p{{ spi.miso.port }}{{ spi.miso.pin_num }}.into_floating_input(&mut gpio{{ spi.miso.port }}.{{ spi.miso.cr_reg }});
{%- endif %}
{%- if spi.mosi %}
    let mosi_{{ spi.bus_name }} = gpio{{ spi.mosi.port }}.p{{ spi.mosi.port }}{{ spi.mosi.pin_num }}.into_alternate_push_pull(&mut gpio{{ spi.mosi.port }}.{{ spi.mosi.cr_reg }});
{%- endif %}

    let spi_mode_{{ spi.bus_name }} = Mode {
        polarity: Polarity::{{ spi.polarity }},
        phase: Phase::{{ spi.phase }},
    };

    let {{ spi.bus_name }} = Spi::spi{{ spi.bus_name[-1] }}(
        dp.{{ spi.pac_bus }},
        (sck_{{ spi.bus_name }}, {% if spi.miso %}miso_{{ spi.bus_name }}{% else %}stm32f1xx_hal::spi::NoMiso{% endif %}, {% if spi.mosi %}mosi_{{ spi.bus_name }}{% else %}stm32f1xx_hal::spi::NoMosi{% endif %}),
        &mut afio.mapr,
        spi_mode_{{ spi.bus_name }},
        {{ spi.frequency_mhz }}.MHz(),
        clocks,
    );
{%- endfor %}
